{
  "name": "dominservice/laravel-cms",
  "type": "library",
  "description": "Laravel CMS Backend",
  "keywords": ["laravel", "cms", "manager"],
  "homepage": "https://github.com/dominservice/laravel-cms",
  "license": "MIT",
  "authors": [
    {
      "name": "dominservice",
      "email": "biuro@dso.biz.pl",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "laravel/framework": "^13.32",
    "astrotomic/laravel-translatable": "^11.17.1",
    "kalnoy/nestedset": "^7.0",
    "dominservice/laravel-media-kit": "^1.2.4|^2.0",
    "dominservice/laravel-config": "^2.3.2|^3.0",
    "livewire/livewire": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "Dominservice\\LaravelCms\\": "src/",
      "Dominservice\\LaravelCms\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.3",
    "phpunit/phpunit": "^13.3"
  },
  "extra": {
    "component": "package",
    "frameworks": ["Laravel 13.x"],
    "laravel": {
      "providers": [
        "Dominservice\\LaravelCms\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "vendor/bin/phpunit -c phpunit.xml.dist"
  }
}
