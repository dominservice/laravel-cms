{
  "name": "dominservice/laravel-cms",
  "type": "library",
  "description": "Laravel CMS for multilingual pages, reusable content blocks, categories and media in a configurable admin panel.",
  "keywords": ["laravel", "cms", "multilingual", "livewire", "content-management"],
  "homepage": "https://github.com/dominservice/laravel-cms",
  "license": "MIT",
  "authors": [
    {
      "name": "Mateusz Domin",
      "email": "biuro@dominsoftware.it",
      "role": "Developer",
      "homepage": "https://dominsoftware.it/"
    }
  ],
  "support": {
    "source": "https://github.com/dominservice/laravel-cms",
    "issues": "https://github.com/dominservice/laravel-cms/issues"
  },
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "laravel/framework": "^13.32",
    "astrotomic/laravel-translatable": "^11.17.1",
    "kalnoy/nestedset": "^7.0",
    "dominservice/laravel-media-kit": "^1.2.4|^2.0",
    "dominservice/laravel-config": "^2.3.2|^3.0",
    "livewire/livewire": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "Dominservice\\LaravelCms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.3",
    "phpunit/phpunit": "^13.3"
  },
  "extra": {
    "component": "package",
    "frameworks": ["Laravel 13.x"],
    "laravel": {
      "providers": [
        "Dominservice\\LaravelCms\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "vendor/bin/phpunit -c phpunit.xml.dist"
  }
}
